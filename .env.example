# Salin ke .env.local dan isi nilai sebenarnya. Jangan commit .env.local.
# Dokumentasi: docs/03-tech-stack.md#6-environment-variables
#
# Aplikasi bisa dijalankan TANPA file ini. Semua nilai di bawah opsional
# untuk pengembangan lokal.

# ---------------------------------------------------------------------------
# Situs
# ---------------------------------------------------------------------------

# URL kanonik. Dipakai untuk metadata, sitemap, dan OG image.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Aplikasi lama (opsional). Kosongkan bila belum ada URL-nya;
# hub akan mengarahkan ke halaman penjelasan agar tidak ada tautan mati.
NEXT_PUBLIC_OPS_URL=""
NEXT_PUBLIC_KEUANGAN_URL=""

# ---------------------------------------------------------------------------
# Sesi
# ---------------------------------------------------------------------------

# Kunci penandatangan cookie sesi. WAJIB diisi saat deploy.
# Buat dengan: openssl rand -base64 32
# Tanpa nilai ini, aplikasi memakai kunci pengembangan yang tidak aman.
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Penyimpanan
# ---------------------------------------------------------------------------

# Isi untuk memakai Postgres (Neon). Kosong = data disimpan di .data/store.json.
# Diisi otomatis oleh `neon deploy`. DATABASE_URL memakai pooler (untuk aplikasi),
# DATABASE_URL_UNPOOLED memakai koneksi langsung (untuk migrasi/DDL).
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# ---------------------------------------------------------------------------
# Neon (dikelola `neon deploy`, jangan diisi tangan)
# ---------------------------------------------------------------------------

# Branch aktif.
NEON_BRANCH=""

# Neon Auth (Managed Better Auth). Dipakai untuk memverifikasi token yang
# diterbitkan Neon Auth; alur login aplikasi tetap memakai kata sandi + PIN.
NEON_AUTH_BASE_URL=""
NEON_AUTH_JWKS_URL=""

# Object Storage (kompatibel S3) untuk berkas dokumen keluarga.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
NEON_OBJECT_STORAGE_BUCKET="assets"

# Set "0" untuk mematikan persistensi berkas lokal.
AIREVO_PERSIST=""

# ---------------------------------------------------------------------------
# Email (form kontak)
# ---------------------------------------------------------------------------

# Tanpa API key, pesan kontak disimpan di outbox lokal dan bisa dilihat
# di /keluarga/pengaturan.
RESEND_API_KEY=""
CONTACT_EMAIL_TO="hello@airevo-digital.my.id"
CONTACT_EMAIL_FROM="Airevo Digital <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Pembayaran
# ---------------------------------------------------------------------------

# Provider aktif: "manual" (transfer bank), "xendit", atau "midtrans".
# Jika provider yang diminta belum dikonfigurasi, aplikasi otomatis
# memakai transfer manual agar checkout tetap bisa diselesaikan.
PAYMENT_PROVIDER="manual"

# Rekening tujuan untuk transfer manual.
PAYMENT_BANK_NAME="BCA"
PAYMENT_BANK_ACCOUNT="1234567890"
PAYMENT_BANK_HOLDER="Airevo Digital"

# Xendit — belum aktif. Isi lalu set PAYMENT_PROVIDER="xendit".
# Implementasi lengkap ada di src/lib/payments/xendit.ts.
XENDIT_SECRET_KEY=""
XENDIT_CALLBACK_TOKEN=""

# Midtrans — belum aktif. Isi lalu set PAYMENT_PROVIDER="midtrans".
# Implementasi lengkap ada di src/lib/payments/midtrans.ts.
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=""

# ---------------------------------------------------------------------------
# Belum dipakai (disiapkan untuk tahap berikutnya)
# ---------------------------------------------------------------------------

# Better Auth (jika nanti pindah dari auth bawaan)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Rate limiting terdistribusi (Upstash)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Error monitoring (Sentry)
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# Penyimpanan berkas (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""
