{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.airevo-digital.my.id" }],
      "destination": "https://airevo-digital.my.id/:path*",
      "permanent": true
    },
    {
      "source": "/minisoccer",
      "destination": "/minisoccer/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/minisoccer/",
      "destination": "https://minisoccer-club.vercel.app/minisoccer/"
    },
    {
      "source": "/minisoccer/:path+",
      "destination": "https://minisoccer-club.vercel.app/minisoccer/:path+"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    }
  ]
}
